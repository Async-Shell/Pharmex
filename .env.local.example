# Supabase — Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Admin dashboard password — pick anything, this gates /admin
ADMIN_PASSWORD=change-me

# Resend (optional) — sends you an email when an order comes in
# Sign up at resend.com, verify a sender, then paste the key here
RESEND_API_KEY=
ORDER_NOTIFY_EMAIL=your-email@example.com
